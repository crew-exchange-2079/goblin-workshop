#!/usr/bin/env python3
"""Run quadlet-lint from a source checkout, without installing it.

Used by the pre-commit hook and the GitHub Action; needs Python 3.10+.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir))

from quadlet_lint.cli import main  # noqa: E402

sys.exit(main())

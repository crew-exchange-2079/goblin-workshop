# A hardened web container: pinned, health-checked, read-only, restartable.
[Unit]
Description=Static web server

[Container]
Image=docker.io/library/nginx@sha256:4f9c2b6e1a7d3c8b5e0f9a2d6c4b1e8f7a3d5c9b2e6f1a4d8c7b3e5f0a9d2c6b
ContainerName=web
PublishPort=127.0.0.1:8080:80
ReadOnly=true
Tmpfs=/var/cache/nginx
DropCapability=ALL
AddCapability=NET_BIND_SERVICE CHOWN SETUID SETGID
NoNewPrivileges=true
HealthCmd=curl -fsS http://localhost/ || exit 1
HealthInterval=30s
HealthOnFailure=kill
StopTimeout=20
Network=app.network
Volume=web-data.volume:/usr/share/nginx/html:ro,Z

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30

[Install]
WantedBy=default.target

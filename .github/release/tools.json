{
  "comment": "Releasable tools. Read by .github/release/release.py; see RELEASING.md. Tags are <name>-v<semver>.",
  "tools": {
    "tape-exporter": {
      "path": "tape-exporter",
      "kind": "python",
      "version": {"file": "lto_exporter/__init__.py", "regex": "^__version__ = \"([^\"]+)\"$"},
      "legacy_tag_prefix": "v",
      "smoke": [["lto-exporter", "--version"]]
    },
    "tapefec": {
      "path": "tapefec",
      "kind": "python",
      "version": {"file": "tapefec.py", "regex": "^__version__ = \"([^\"]+)\"$"},
      "smoke": [["tapefec", "--version"]]
    },
    "quadlet-lint": {
      "path": "quadlet-lint",
      "kind": "python",
      "version": {"file": "quadlet_lint/__init__.py", "regex": "^__version__ = \"([^\"]+)\"$"},
      "smoke": [["quadlet-lint", "--version"]]
    },
    "rack-parts": {
      "path": "rack-parts",
      "kind": "source",
      "version": {"file": "rackparts/__init__.py", "regex": "^__version__ = \"([^\"]+)\"$"}
    },
    "ltfs-index-validator": {
      "path": "ltfs-index-validator",
      "kind": "source",
      "version": {"file": "validate.py", "regex": "^TOOL_VERSION = \"([^\"]+)\"$"}
    },
    "hsm-sim": {
      "path": "hsm-sim",
      "kind": "source",
      "version": {"file": "hsm_sim.py", "regex": "^__version__ = \"([^\"]+)\"$"}
    },
    "timer2dagu": {
      "path": "timer2dagu",
      "kind": "source",
      "version": {"file": "timer2dagu.py", "regex": "^__version__ = \"([^\"]+)\"$"}
    },
    "tape-library-playground": {
      "path": "tape-library-playground",
      "kind": "static",
      "version": {"file": "package.json", "json": "version"},
      "files": ["index.html", "sim.js", "ui.js", "style.css", "README.md", "TEACHES.md", "LICENSE", "CHANGELOG.md"]
    }
  },
  "not_released": {
    "tape-regression-lab": "regression evidence kit for an upstream project, not a tool",
    "tests": "cross-project regression tests",
    "examples": "walkthroughs across tools, not a tool"
  }
}
